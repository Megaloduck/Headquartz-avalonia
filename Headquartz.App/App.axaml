<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Headquartz.App.App"
             xmlns:local="using:Headquartz.App"
             RequestedThemeVariant="Dark">

	<Application.DataTemplates>
		<local:ViewLocator/>
	</Application.DataTemplates>

	<Application.Resources>
    <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="avares://Headquartz.App/Assets/Styles/IconResources.axaml"/>
            <ResourceInclude Source="avares://Headquartz.App/Assets/Styles/TypographyResources.axaml"/>
        </ResourceDictionary.MergedDictionaries>

        <ResourceInclude x:Key="Dark" Source="avares://Headquartz.App/Assets/Themes/DarkTheme.axaml"/>
        <ResourceInclude x:Key="Light" Source="avares://Headquartz.App/Assets/Themes/LightTheme.axaml"/>
    </ResourceDictionary>
</Application.Resources>

	<Application.Styles>
		<FluentTheme />
        <StyleInclude Source="avares://Headquartz.App/Assets/Styles/TypographyStyles.axaml"/>
		<StyleInclude Source="avares://Headquartz.App/Assets/Styles/AppStyles.axaml"/>
	</Application.Styles>


</Application>