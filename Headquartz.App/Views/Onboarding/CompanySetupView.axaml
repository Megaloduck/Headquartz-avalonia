<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Headquartz.App.CompanySetupView"
             Background="{DynamicResource BrushBgBase}">

  


        <Grid RowDefinitions="Auto,*" Margin="20" RowSpacing="20">

            <!-- ═══════════ HEADER ═══════════ -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" >
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Company Setup"
                               Classes="page-title"    />
                    <TextBlock Text="Configure your company before the sessions begins"
                               Classes="page-subtitle"    />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                    <Button Classes="toggletheme"
                            Padding="10"
                            ToolTip.Tip="Toggle Theme"
                            Command="{Binding ToggleThemeCommand}">
                        <TextBlock Text="☀" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}"/>
                    </Button>
                    <Button Classes="danger"
                            Padding="16,10"
                            Command="{Binding GoBackCommand}">
                        <TextBlock Text="Return to Main Menu"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══════════ MAIN CONTENT ═══════════ -->
            <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="20">

                <!-- ┌────────── LEFT: Configuration Summary ──────────┐ -->
                <Border Classes="page" Padding="22" >
                    <StackPanel Spacing="20">

                        <TextBlock Text="Configuration Summary"
                                    Classes="section-title"    />

                        <!-- Company icon placeholder -->
                        <Border Height="280"
                                CornerRadius="12"
                               Background="{DynamicResource BrushBgElevated}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1">

                            <TextBlock Text="{Binding SelectedIndustryEmoji}"       FontSize="72"       
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        </Border>                       

                        <TextBlock Text="{Binding CompanyName}"
                                   FontSize="28"                                  
                                   FontWeight="Heavy"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>

                        <Grid ColumnDefinitions="100,*" ColumnSpacing="20">
                            <!--INDUSTRY STATUS-->
                            <StackPanel>
                                <TextBlock Text="INDUSTRY"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           LetterSpacing="1"/>
                                <TextBlock Text="{Binding SelectedIndustry}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                            </StackPanel>

                            <!--DIFFICULTY STATUS-->
                            <StackPanel Grid.Column="1">
                                 <TextBlock Text="DIFFICULTY"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       LetterSpacing="1"/>
                            <TextBlock Text="{Binding SelectedDifficulty}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>                            
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <TextBlock Text="STARTING CAPITAL"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       LetterSpacing="1"/>
                            <TextBlock Text="{Binding CapitalDisplay}"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushSuccess}"/>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <!-- ┌────────── RIGHT: Form ──────────┐ -->
             <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="20">
                <Border Classes="page"  Padding="22">
                    <StackPanel Spacing="24" VerticalAlignment="Stretch">

                        <!-- Company Name -->
                        <StackPanel Spacing="15">
                            <TextBlock Text="Company Name"
                                        Classes="section-title"    />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Text="{Binding CompanyName}"
                                         PlaceholderText="Company Name"
                                         FontSize="20"
                                         Padding="16,14"
                                         CornerRadius="10"/>
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="20,14"
                                        Background="{DynamicResource BrushBgInput}"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Command="{Binding RandomNameCommand}">
                                    <TextBlock Text="Randomize"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextPrimary}"/>
                                </Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="*3 letters minimum"
                                       FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                            <TextBlock Text="{Binding ErrorMessage}"  IsVisible="{Binding HasError}"
                                       FontSize="12"  Foreground="{DynamicResource BrushDanger}"/>
                            </StackPanel>
                            
                        </StackPanel>

                        <!-- Industry type -->
                        <StackPanel Spacing="15">
                            <TextBlock Text="Industry Type"
                                       Classes="section-title"    />
                            <ItemsControl ItemsSource="{Binding Industries}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="5"
                                                     ColumnSpacing="10"
                                                     RowSpacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Command="{Binding $parent[ItemsControl].DataContext.SelectIndustryCommand}"
                                                CommandParameter="{Binding}">
                                            <Border Height="70" Classes="card"
                                                    Classes.selected="{Binding IsSelected}">
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding IndustryDescription}"
                                       FontSize="13"
                                       Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>

                        <!-- Difficulty -->
                        <StackPanel Spacing="15">
                            <TextBlock Text="Difficulty" 
                                      Classes="section-title"    />
                            <ItemsControl ItemsSource="{Binding Difficulties}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"
                                                     ColumnSpacing="10"
                                                     RowSpacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                          <Button HorizontalAlignment="Stretch"  
                                                HorizontalContentAlignment="Stretch"
                                                Padding="0"
                                                Background="Transparent"    
                                                BorderThickness="0"
                                                Command="{Binding $parent[ItemsControl].DataContext.SelectDifficultyCommand}"        
                                                CommandParameter="{Binding}">
                                            <Border Height="70" Classes="card"
                                                    Classes.selected="{Binding IsSelected}">
                                                <Grid ColumnDefinitions="*,Auto"        ColumnSpacing="20">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontSize="16"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1"              
                                                                HorizontalAlignment="Right"
                                                                Spacing="2">
                                                        <TextBlock Text="Starting at"
                                                                   FontSize="11"                                                
                                                                   Foreground="{DynamicResource BrushTextMuted}"/>
                                                        <TextBlock Text="{Binding CapitalAmount}"                 
                                                                   FontSize="16"
                                                                   FontWeight="Bold"                         
                                                                   Foreground="{DynamicResource BrushSuccess}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding DifficultyDescription}"                                       
                                       FontSize="13"
                                       Foreground="{DynamicResource BrushTextMuted}"/>
                        </StackPanel>

                        

                       

                    </StackPanel>
                     
                </Border>
               
                    <!-- Confirm -->
                        <Button  Grid.Row="1"
                            HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Padding="0,16"
                                CornerRadius="12"
                                Command="{Binding ConfirmCommand}">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="{DynamicResource ColorAccentPrimary}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource ColorAccentPrimaryHover}" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <TextBlock Text="Select Department →"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       HorizontalAlignment="Center"/>
                        </Button>
                </Grid>
                
            </Grid>
        </Grid>
 

</UserControl>
