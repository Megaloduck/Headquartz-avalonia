<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             x:Class="Headquartz.App.LobbyView"
             Background="{DynamicResource BrushBgBase}">

    <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="20">

        <!-- ═══════════ HEADER ═══════════ -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Game Lobby" Classes="page-title"/>
                <TextBlock Text="Each role has unique responsibilities. Coordinate with your team to cover all departments."
                           Classes="page-subtitle"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Top">
                <Button Padding="10" ToolTip.Tip="Toggle Theme" Command="{Binding ToggleThemeCommand}">
                    <Path Data="{DynamicResource IconSun}" Width="14" Height="14" Stretch="Uniform"
                          Fill="Transparent" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.5"/>
                </Button>
                <Button Classes="danger" Padding="16,10" Command="{Binding LeaveRoomCommand}">
                    <TextBlock Text="Return to Main Menu" FontSize="14" FontWeight="SemiBold"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════ MAIN CONTENT ═══════════ -->
        <Grid Grid.Row="1" ColumnDefinitions="300,*,300" ColumnSpacing="20">

            <!-- ┌────────── LEFT: Player ID Card ──────────┐ -->
            <Border Classes="page" Padding="22" >
                <StackPanel Spacing="20">

                    <TextBlock Text="Player ID Card" Classes="section-title"    />

                    <!-- Player icon placeholder -->
                        <Border Height="280" CornerRadius="12"
                               Background="{DynamicResource BrushBgElevated}"
                                BorderBrush="{DynamicResource BrushBorderSubtle}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding PlayerAvatar}" FontSize="72"                           
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource BrushTextPrimary}" />
                        </Border>

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding PlayerName}" FontSize="28"  FontWeight="Heavy"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding PlayerLevel, StringFormat='Level {0}'}"
                                       Classes="caption" VerticalAlignment="Center"/>
                        </Grid>

                    
                     <Grid ColumnDefinitions="150,*" ColumnSpacing="20">
                         <!--DEPARTMENT STATUS-->
                        <StackPanel >
                            <TextBlock Text="DEPARTMENT" Classes="label-upper"/>
                            <TextBlock Text="{Binding PlayerDepartmentName}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}"/>
                        </StackPanel>

                         <!--PING STATUS-->
                         <StackPanel Grid.Column="1">
                         <TextBlock Text="PING" Classes="label-upper"/>
                        <Border Padding="8,4" CornerRadius="6"
                                Background="{DynamicResource BrushBadgeSuccessBg}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource BrushSuccess}"/>
                                <TextBlock Text="{Binding LocalPing, StringFormat='{}{0} ms'}" FontSize="11"
                                           Foreground="{DynamicResource BrushBadgeSuccessFg}"/>
                            </StackPanel>
                        </Border>
                             </StackPanel>
                         </Grid>
                    

                    <Button Margin="0,16,0,0" HorizontalAlignment="Stretch" Padding="0,14"
                            CornerRadius="12"
                            IsEnabled="{Binding HasLocalDepartment}"
                            Command="{Binding PrintIdCardCommand}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="{DynamicResource ColorAccentPrimary}" Offset="0"/>
                                <GradientStop Color="{DynamicResource ColorAccentPrimaryHover}" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock Text="{Binding PrintButtonLabel}" FontSize="14" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"/>
                    </Button>

                </StackPanel>
            </Border>

            <!-- ┌────────── CENTER: Responsibilities + Selection ──────────┐ -->
            <Border Grid.Column="1" Padding="24" Background="{DynamicResource BrushBgSurface}"
                    BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                <StackPanel Spacing="12">                
                    

                <!-- State 1: host hasn't configured the company yet -->
                <StackPanel IsVisible="{Binding ShowConfigureCompanyButton}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                    <TextBlock Text="Configure your company to unlock department selection."
                               Classes="secondary" />
                    <Button HorizontalAlignment="Center" Padding="22,12" CornerRadius="12"
                            Command="{Binding ConfigureCompanyCommand}">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Color="{DynamicResource ColorAccentPrimary}" Offset="0"/>
                                <GradientStop Color="{DynamicResource ColorAccentPrimaryHover}" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <TextBlock Text="Configure Company →" FontWeight="Bold" Foreground="White"/>
                    </Button>
                </StackPanel>

                <!-- State 2: joiner waiting on the host -->
                <TextBlock IsVisible="{Binding ShowWaitingForCompany}"
                           Text="Waiting for the host to configure the company..."
                           Classes="secondary" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- State 3: company configured — responsibilities + grid -->
                <Grid IsVisible="{Binding !ShowConfigureCompanyButton, FallbackValue=True}" RowDefinitions="Auto,Auto,*" RowSpacing="20">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!ShowConfigureCompanyButton"/>
                            <Binding Path="!ShowWaitingForCompany"/>
                        </MultiBinding>
                    </Grid.IsVisible>

                    <TextBlock Grid.Row="0" Text="Department Responsibilities" Classes="section-title"/>

                    <Border Grid.Row="1" Padding="0">
                        <Grid ColumnDefinitions="240,20,*">
                            <Border Grid.Column="0" CornerRadius="12"
                                    Background="{Binding PreviewCard.AccentColor}" Height="150">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                    <TextBlock Text="{Binding PreviewCard.Emoji}" FontSize="36" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Gameplay Preview" FontSize="11" Foreground="White" Opacity="0.85"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="2" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PreviewCard.Title}" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text="{Binding PreviewCard.ResponsibilitiesSummary}"
                                           Classes="secondary" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Text="Department Selection" Classes="section-title"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <ProgressBar Value="{Binding CoverageRatio}" Maximum="1" Width="140" Height="6"
                                             Foreground="{DynamicResource BrushAccentPrimary}"/>
                                <TextBlock Classes="caption">
                                    <Run Text="{Binding DepartmentsCovered}"/>
                                    <Run Text="/"/>
                                    <Run Text="{Binding DepartmentsTotal}"/>
                                    <Run Text=" covered"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <!--Department Selection Items-->
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4" ColumnSpacing="10" RowSpacing="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"                                    
                                               Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                IsEnabled="{Binding !IsTaken}"
                                                PointerEntered="OnCardPointerEntered"
                                                Command="{Binding $parent[ItemsControl].DataContext.SelectCardCommand}"
                                                CommandParameter="{Binding}">
                                        <Border Classes="card"
                                            Classes.selected="{Binding IsSelected}"
                                            Classes.taken="{Binding IsTaken}"
                                            CornerRadius="12"
                                            Padding="14">

                                            <Grid RowDefinitions="Auto,*,Auto">

                                                <Border Grid.Row="0" Width="40" Height="40  " CornerRadius="18"
                                                        Background="{Binding AccentColor}" 
                                                        HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Emoji}" FontSize="25"   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                

                                                <TextBlock Grid.Row="1" Text="{Binding Department}" FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           TextWrapping="Wrap" VerticalAlignment="Bottom"/>

                                                <Border Grid.Row="2" IsVisible="{Binding IsSelected}" Margin="0,8,0,0"
                                                        Padding="6,2" CornerRadius="6"
                                                        Background="{DynamicResource BrushBadgeSuccessBg}"
                                                        HorizontalAlignment="Left">
                                                    <TextBlock Text="YOURS" Classes="badge-text"
                                                               Foreground="{DynamicResource BrushBadgeSuccessFg}"/>
                                                </Border>

                                                <TextBlock Grid.Row="2" IsVisible="{Binding IsTaken}" Margin="0,8,0,0"
                                                           Text="{Binding TakenByUsername}" FontSize="10"
                                                           Foreground="{DynamicResource BrushTextMuted}"
                                                           TextTrimming="CharacterEllipsis"/>

                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Keep others pick one" Classes="figure"/>

                    </StackPanel>
                </Grid>
                    </StackPanel>
                    </Grid>   
            </Border>

            <!-- ┌────────── RIGHT: Room + Players + Start ──────────┐ -->
            <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">

                <StackPanel Grid.Row="0" Spacing="12">
                    <Border IsVisible="{Binding IsMultiplayer}" Padding="18" Background="{DynamicResource BrushBgSurface}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1"
                            CornerRadius="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="ROOM CODE" Classes="label-upper"/>                                
                                <TextBlock Text="{Binding RoomCode}" FontSize="24" FontWeight="Black"
                                           Foreground="{DynamicResource BrushTextPrimary}" LetterSpacing="4"/>
                                <TextBlock Text="Share this code with your team" Classes="caption"/>
                            </StackPanel>
                            <Button Grid.Column="1" Padding="10,7" Background="{DynamicResource BrushBgInput}"
                                    CornerRadius="12" VerticalAlignment="Center"
                                    Command="{Binding CopyRoomCodeCommand}">
                                <TextBlock Text="📋 Copy" FontSize="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Padding="18" Background="{DynamicResource BrushBgSurface}"
                            BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1"
                            CornerRadius="12">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="PLAYERS" Classes="label-upper"/>
                                <Border Padding="7,1" CornerRadius="6"
                                        Background="{DynamicResource BrushBgInput}">
                                    <TextBlock Text="{Binding Players.Count}" FontSize="11"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Players}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="10,8" Background="{DynamicResource BrushBgInput}"
                                                CornerRadius="12">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding AvatarEmoji}" FontSize="16"
                                                           Margin="0,0,8,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding Username}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource BrushTextPrimary}"/>
                                                        <TextBlock Text="HOST" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushAccentPrimaryHover}"
                                                                   IsVisible="{Binding IsHost}"/>
                                                        <TextBlock Text="YOU" FontSize="9" FontWeight="Bold"
                                                                   Foreground="{DynamicResource BrushSuccess}"
                                                                   IsVisible="{Binding IsLocalPlayer}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Level, StringFormat='Level {0}'}" Classes="caption"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" FontSize="11"
                                                           FontWeight="SemiBold" Foreground="{Binding StatusColor}"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="1" Margin="0,12,0,0" Padding="16" Background="{DynamicResource BrushBgSurface}"
                        BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1"
                        CornerRadius="12">
                    <TextBlock Text="{Binding StatusMessage}" Classes="caption" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                </Border>

                <Button Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Stretch" Padding="0,14"
                        CornerRadius="12"
                        IsVisible="{Binding IsHost}"
                        IsEnabled="{Binding CanStart}"
                        Command="{Binding StartGameCommand}">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="{DynamicResource ColorSuccess}" Offset="0"/>
                            <GradientStop Color="{DynamicResource ColorSuccess}" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <TextBlock Text="Start Game →" FontSize="14" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center"/>
                </Button>

            </Grid>

        </Grid>
    </Grid>

</UserControl>