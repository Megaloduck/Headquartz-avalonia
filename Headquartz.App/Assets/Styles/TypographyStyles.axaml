<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
       TEXT HIERARCHY
       - Lora				  =     for display headings/department titles
	   - Inter				  =     (app default) for operational/data text
	   - JetBrainsMono =     New for timestamps and precision-critical values.
       Classes are additive — combine freely, e.g. Classes="money text-danger".
       ============================================================ -->

	<Style Selector="TextBlock">
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>

	<!-- ── Font-family utilities (orthogonal, combine with anything) ── -->
	<Style Selector="TextBlock.font-display">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
	</Style>
	<Style Selector="TextBlock.font-mono">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}"/>
	</Style>

	<!-- ── Display / Headings (Georgia) ──────────────────────────── -->

	<!-- Hero text: splash screens, big standalone numbers -->
	<Style Selector="TextBlock.display">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
		<Setter Property="FontSize"   Value="{DynamicResource FontSizeDisplay}"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>

	<!-- Top-of-page header, e.g. "Finance Dashboard" -->
	<Style Selector="TextBlock.page-title">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
		<Setter Property="FontSize"   Value="{DynamicResource FontSizeDisplay}"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>

	<!-- One-line description under a page title -->
	<Style Selector="TextBlock.page-subtitle">
		<Setter Property="FontSize"   Value="{DynamicResource FontSizeBase}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
	</Style>

	<!-- Department / company name display -->
	<Style Selector="TextBlock.dept-title">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
		<Setter Property="FontSize"   Value="{DynamicResource FontSizeXl}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>

	<!-- Card-level section header, e.g. "Department Budgets" -->
	<Style Selector="TextBlock.section-header">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
		<Setter Property="FontSize"   Value="{DynamicResource FontSizeH2}"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Margin"     Value="0,0,0,16"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>

	<!-- Smaller in-card subheader -->
	<Style Selector="TextBlock.subsection-header">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
		<Setter Property="FontSize"   Value="{DynamicResource FontSizeH3}"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>

	<!-- ── Operational / body text (Inter — app default) ────────── -->

	<Style Selector="TextBlock.sidebar-title">
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize"   Value="14"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>

	<Style Selector="TextBlock.base-text">
		<Setter Property="FontSize"   Value="13"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
	</Style>

	<Style Selector="TextBlock.secondary-text">
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize"   Value="13"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
	</Style>

	<!-- KPI card label, e.g. "Cash" above a KPI value -->
	<Style Selector="TextBlock.kpi-label">
		<Setter Property="FontSize"   Value="{DynamicResource FontSizeBase}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
	</Style>

	<!-- Uppercase micro-label, e.g. "CURRENT TICK", "ROOM CODE" -->
	<Style Selector="TextBlock.label-upper">
		<Setter Property="FontSize"     Value="{DynamicResource FontSizeSm}"/>
		<Setter Property="FontWeight"   Value="SemiBold"/>
		<Setter Property="LetterSpacing" Value="0.5"/>
		<Setter Property="Foreground"   Value="{DynamicResource BrushTextMuted}"/>
	</Style>

	<!-- Small helper/footnote text -->
	<Style Selector="TextBlock.caption">
		<Setter Property="FontSize"   Value="{DynamicResource FontSizeSm}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
	</Style>

	<!-- Small bold text inside pill/badge borders, e.g. "TAKEN", "REVIEWED" -->
	<Style Selector="TextBlock.badge-text">
		<Setter Property="FontSize"      Value="9"/>
		<Setter Property="FontWeight"    Value="Bold"/>
		<Setter Property="LetterSpacing" Value="0.3"/>
	</Style>

	<!-- ── Precision-critical data (Courier New) ─────────────────── -->
	<!-- Per Build Guide §4.1: numeric figures, KPI values, and
	     timestamps use monospace so digits align and stay unambiguous. -->

	<!-- Headline KPI number, e.g. the big number in a KPI card -->
	<Style Selector="TextBlock.kpi-value">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}"/>
		<Setter Property="FontSize"   Value="{DynamicResource FontSizeKpi}"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>

	<!-- Inline monetary figure, e.g. "$25,000" in a table row -->
	<Style Selector="TextBlock.money">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
	</Style>

	<!-- Generic numeric figure: tick counts, quantities, percentages -->
	<Style Selector="TextBlock.figure">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}"/>
	</Style>

	<!-- Timestamps, e.g. "MM/dd HH:mm" -->
	<Style Selector="TextBlock.timestamp">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}"/>
		<Setter Property="FontSize"   Value="{DynamicResource FontSizeSm}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
	</Style>

	<!-- ── Semantic color variants (combine with any class above) ── -->

	<Style Selector="TextBlock.text-muted">
		<Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
	</Style>

	<Style Selector="TextBlock.text-secondary">
		<Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
	</Style>

	<Style Selector="TextBlock.text-success">
		<Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
	</Style>

	<Style Selector="TextBlock.text-danger">
		<Setter Property="Foreground" Value="{DynamicResource BrushDanger}"/>
	</Style>

	<Style Selector="TextBlock.text-warning">
		<Setter Property="Foreground" Value="{DynamicResource BrushWarning}"/>
	</Style>

	<Style Selector="TextBlock.text-accent">
		<Setter Property="Foreground" Value="{DynamicResource BrushAccentPrimary}"/>
	</Style>

  <!-- Add Styles Here -->

    <Style Selector="TextBlock.display">	
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeDisplay}"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="LineHeight" Value="{DynamicResource LineHeightDisplay}"/>
		<Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingDisplay}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>

    <Style Selector="TextBlock.page-title">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeH1}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="LineHeight" Value="{DynamicResource LineHeightH1}"/>
		<Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingHeading}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>
    <Style Selector="TextBlock.section-title">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeH2}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="LineHeight" Value="{DynamicResource LineHeightH2}"/>
		<Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingHeading}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>
    <Style Selector="TextBlock.subsection-title">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyDisplay}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeH3}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="LineHeight" Value="{DynamicResource LineHeightH3}"/>
		<Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingHeading}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>
    <Style Selector="TextBlock.body">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}"/>
		<Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingBody}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>

    <Style Selector="TextBlock.label">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingLabel}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>
    <Style Selector="TextBlock.secondary">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="LineHeight" Value="{DynamicResource LineHeightBody}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
	</Style>
    <Style Selector="TextBlock.caption">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="LineHeight" Value="{DynamicResource LineHeightCaption}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
	</Style>
    <Style Selector="TextBlock.label-upper">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="LetterSpacing" Value="{DynamicResource LetterSpacingUppercase}"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
	</Style>
    <Style Selector="TextBlock.badge-text">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeMicro}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>
    <Style Selector="TextBlock.kpi-value">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeKpi}"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>
    <Style Selector="TextBlock.figure">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeFigure}"/>
		<Setter Property="FontWeight" Value="Normal"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
	</Style>
    <Style Selector="TextBlock.money">
		<Setter Property="FontFamily" Value="{DynamicResource FontFamilyMono}"/>
		<Setter Property="FontSize" Value="{DynamicResource FontSizeFigure}"/>
		<Setter Property="FontWeight" Value="Medium"/>
		<Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
</Styles>







