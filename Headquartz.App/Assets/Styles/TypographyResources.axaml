<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ─────────────────────────────────────────────────────────── -->
	<!-- TYPOGRAPHY																							                 -->
	<!-- ─────────────────────────────────────────────────────────── -->


  <!-- Font families -->
<FontFamily x:Key="FontFamilyDisplay">avares://Headquartz.App/Assets/Fonts/Lora.ttf#Lora</FontFamily>
<FontFamily x:Key="FontFamilyBody">avares://Headquartz.App/Assets/Fonts/Inter.ttf#Inter</FontFamily>
<FontFamily x:Key="FontFamilyMono">avares://Headquartz.App/Assets/Fonts/JetBrainsMono.ttf#JetBrainsMono</FontFamily>



	<!-- Sizing values — see Build Guide §4.1 -->
	<x:Double x:Key="FontSizeXs">10</x:Double>
	<x:Double x:Key="FontSizeSm">11</x:Double>
	<x:Double x:Key="FontSizeMd">12</x:Double>
	<x:Double x:Key="FontSizeBase">13</x:Double>
	<x:Double x:Key="FontSizeLg">14</x:Double>
	<x:Double x:Key="FontSizeXl">16</x:Double>
	<x:Double x:Key="FontSizeH3">18</x:Double>
	<x:Double x:Key="FontSizeH2">22</x:Double>
	<x:Double x:Key="FontSizeH1">25</x:Double>
	<x:Double x:Key="FontSizeDisplay">28</x:Double>
	<x:Double x:Key="FontSizeKpi">20</x:Double>



	


</ResourceDictionary>
