<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ─────────────────────────────────────────────────────────── -->
	<!-- TYPOGRAPHY																							                 -->
	<!-- ─────────────────────────────────────────────────────────── -->


  <!-- Font families -->
<FontFamily x:Key="FontFamilyDisplay">avares://Headquartz.App/Assets/Fonts/Lora.ttf#Lora</FontFamily>
<FontFamily x:Key="FontFamilyBody">avares://Headquartz.App/Assets/Fonts/Inter.ttf</FontFamily>
<FontFamily x:Key="FontFamilyMono">avares://Headquartz.App/Assets/Fonts/JetBrainsMono.ttf</FontFamily>



	<!-- Sizing values — see Typography Styles -->
<x:Double x:Key="FontSizeMicro">10</x:Double>
<x:Double x:Key="FontSizeCaption">11</x:Double>
<x:Double x:Key="FontSizeSmall">12</x:Double>
<x:Double x:Key="FontSizeBody">13</x:Double>
<x:Double x:Key="FontSizeUI">14</x:Double>
<x:Double x:Key="FontSizeH3">16</x:Double>
<x:Double x:Key="FontSizeH2">20</x:Double>
<x:Double x:Key="FontSizeH1">26</x:Double>
<x:Double x:Key="FontSizeDisplay">32</x:Double>
<x:Double x:Key="FontSizeKpi">28</x:Double>
<x:Double x:Key="FontSizeFigure">13</x:Double>
<x:Double x:Key="FontSizeTimestamp">11</x:Double>
<x:Double x:Key="LineHeightDisplay">38</x:Double>
<x:Double x:Key="LineHeightH1">32</x:Double>
<x:Double x:Key="LineHeightH2">26</x:Double>
<x:Double x:Key="LineHeightH3">22</x:Double>
<x:Double x:Key="LineHeightBody">20</x:Double>
<x:Double x:Key="LineHeightUI">20</x:Double>
<x:Double x:Key="LineHeightCaption">16</x:Double>
<x:Double x:Key="LetterSpacingDisplay">-0.25</x:Double>
<x:Double x:Key="LetterSpacingHeading">-0.1</x:Double>
<x:Double x:Key="LetterSpacingBody">0</x:Double>
<x:Double x:Key="LetterSpacingLabel">0.25</x:Double>
<x:Double x:Key="LetterSpacingUppercase">0.8</x:Double>



	


</ResourceDictionary>
